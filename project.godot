[application]

config/name="GULP"
run/main_scene="res://scenes/game.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.075, 1)

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
move_up={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
jump={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
spew={
"deadzone": 0.3,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
gulp={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventMouseButton,"button_index":2)]
}
restart={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="HazardsGoals"
